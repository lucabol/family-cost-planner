{
  "name": "family-cost-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "apply:defaults": "node scripts/apply-default-policy.mjs data/costs.v1.json",
    "validate:data": "node scripts/validate-data.mjs data/costs.v1.json",
    "validate:candidate": "node scripts/validate-data.mjs data/candidate.json --baseline data/costs.v1.json",
    "validate:fx": "node scripts/validate-exchange-rate.mjs data/exchange-rates.v1.json",
    "refresh:fx": "node scripts/refresh-exchange-rate.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
