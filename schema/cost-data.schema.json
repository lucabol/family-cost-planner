{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucabol.github.io/family-cost-planner/schema/cost-data.schema.json",
  "title": "Family cost planner evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "refreshedAt", "household", "cities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "refreshedAt": { "type": "string", "format": "date-time" },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adults", "universityStudentsAtHome", "secondaryStudents", "notes"],
      "properties": {
        "adults": { "const": 2 },
        "universityStudentsAtHome": { "const": 1 },
        "secondaryStudents": { "const": 1 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "cities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/city" }
    }
  },
  "$defs": {
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "currency", "locale", "sources", "items"],
      "properties": {
        "id": { "enum": ["javea", "savona", "seattle"] },
        "name": { "type": "string", "minLength": 1 },
        "country": { "enum": ["Spain", "Italy", "United States"] },
        "currency": { "enum": ["EUR", "USD"] },
        "locale": { "enum": ["es-ES", "it-IT", "en-US"] },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "reliability", "observationDate", "retrievedAt", "staleAfterDays", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "reliability": {
          "enum": ["high", "medium-high", "medium", "medium-low", "planning-assumption"]
        },
        "observationDate": { "type": "string", "format": "date" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "staleAfterDays": { "type": "integer", "minimum": 7, "maximum": 730 },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "defaultMonthly", "defaultSelection", "notes", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "defaultMonthly": { "type": "number", "minimum": 0 },
        "defaultSelection": { "$ref": "#/$defs/defaultSelection" },
        "notes": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "original", "monthlyNormalized", "comparison", "overlaps", "notes"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "currency", "value"],
          "properties": {
            "unit": { "enum": ["monthly", "annual", "one-time", "qualitative"] },
            "currency": { "enum": ["EUR", "USD", "NONE"] },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "monthlyNormalized": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": { "value": { "type": "number", "minimum": 0 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "comparison": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": { "const": "comparable" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reasonCode", "reason"],
              "properties": {
                "status": { "const": "excluded" },
                "reasonCode": {
                  "enum": [
                    "wrong-household-size",
                    "overlapping-bundle",
                    "different-housing-type",
                    "different-item-scope",
                    "qualitative-only",
                    "missing-normalization",
                    "partial-item-coverage",
                    "other"
                  ]
                },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "overlaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["housing", "food", "transport", "healthcare", "other-household"]
          }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "defaultSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "selectedSourceId",
        "selectedMonthlyValue",
        "comparableCandidates",
        "excludedEvidence",
        "reviewFlags"
      ],
      "properties": {
        "policy": { "const": "highest-comparable-upper-bound" },
        "selectedSourceId": { "type": "string", "minLength": 1 },
        "selectedMonthlyValue": { "type": "number", "minimum": 0 },
        "comparableCandidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "monthlyUpperBound"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "monthlyUpperBound": { "type": "number", "minimum": 0 }
            }
          }
        },
        "excludedEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "reasonCode", "reason"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "reasonCode": {
                "enum": [
                  "wrong-household-size",
                  "overlapping-bundle",
                  "different-housing-type",
                  "different-item-scope",
                  "qualitative-only",
                  "missing-normalization",
                  "partial-item-coverage",
                  "other"
                ]
              },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reviewFlags": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "sourceId", "explanation"],
                "properties": {
                  "code": { "const": "single-source-low-confidence" },
                  "sourceId": { "type": "string", "minLength": 1 },
                  "explanation": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "sourceId",
                  "gapPercent",
                  "nextHighestMonthly",
                  "explanation"
                ],
                "properties": {
                  "code": { "const": "singleton-outlier" },
                  "sourceId": { "type": "string", "minLength": 1 },
                  "gapPercent": {
                    "type": ["number", "null"],
                    "exclusiveMinimum": 25
                  },
                  "nextHighestMonthly": { "type": "number", "minimum": 0 },
                  "explanation": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
