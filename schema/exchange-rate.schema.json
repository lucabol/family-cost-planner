{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucabol.github.io/family-cost-planner/schema/exchange-rate.schema.json",
  "title": "Family Cost Planner exchange-rate fallback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseCurrency",
    "quoteCurrency",
    "rate",
    "observationDate",
    "retrievedAt",
    "sourceName",
    "sourceUrl",
    "staleAfterDays"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseCurrency": { "const": "EUR" },
    "quoteCurrency": { "const": "USD" },
    "rate": { "type": "number", "exclusiveMinimum": 0 },
    "observationDate": { "type": "string", "format": "date" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceName": {
      "const": "Frankfurter — ECB reference rates"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://api\\.frankfurter\\.dev/"
    },
    "staleAfterDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    }
  }
}
